{
  "info": {
    "_postman_id": "e0a11a8b-4b2a-4db3-96b0-75b28d9a2631",
    "name": "EatsNow - Identity Service",
    "description": "Postman Collection for EatsNow Identity & Access Service (Spec 3.1 & 3.2, ADR 005), through the API Gateway. Identity is an OIDC provider (Spring Authorization Server): folders authenticate with OAuth 2.0 authorization code + PKCE (client eatsnow-cli). Click 'Get New Access Token' on a folder and log in on the Identity page with the account named in the token name.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication & OIDC",
      "item": [
        {
          "name": "1. OIDC Discovery Document",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/.well-known/openid-configuration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "openid-configuration"
              ]
            },
            "description": "Issuer, authorization, token, JWKS, userinfo and logout endpoints of the Identity OIDC provider."
          }
        },
        {
          "name": "2. Get Public JWKS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/jwks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "jwks"
              ]
            },
            "description": "RS256 public keys used by the Gateway and every service to validate access tokens locally."
          }
        }
      ],
      "description": "Public OIDC endpoints. Login is not an API call: it is the authorization-code flow with PKCE, configured on the folders below (Authorization tab, 'Get New Access Token')."
    },
    {
      "name": "Self-Service Profiles (/profiles/me)",
      "item": [
        {
          "name": "1. Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profiles",
                "me"
              ]
            },
            "description": "Returns the authenticated user's own profile."
          }
        },
        {
          "name": "2. Update My Display Name",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Alex Rivera\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profiles",
                "me"
              ]
            },
            "description": "Allows authenticated user to update their displayName only. Requires Idempotency-Key: UUID."
          }
        }
      ],
      "auth": {
        "type": "oauth2",
        "oauth2": [
          {
            "key": "grant_type",
            "value": "authorization_code_with_pkce",
            "type": "string"
          },
          {
            "key": "authUrl",
            "value": "{{baseUrl}}/oauth2/authorize",
            "type": "string"
          },
          {
            "key": "accessTokenUrl",
            "value": "{{baseUrl}}/oauth2/token",
            "type": "string"
          },
          {
            "key": "clientId",
            "value": "eatsnow-cli",
            "type": "string"
          },
          {
            "key": "clientSecret",
            "value": "dev-cli-secret",
            "type": "string"
          },
          {
            "key": "scope",
            "value": "openid",
            "type": "string"
          },
          {
            "key": "redirect_uri",
            "value": "https://oauth.pstmn.io/v1/callback",
            "type": "string"
          },
          {
            "key": "challengeAlgorithm",
            "value": "S256",
            "type": "string"
          },
          {
            "key": "client_authentication",
            "value": "header",
            "type": "string"
          },
          {
            "key": "tokenName",
            "value": "EatsNow customer (log in as alex@example.test / password123)",
            "type": "string"
          },
          {
            "key": "addTokenTo",
            "value": "header",
            "type": "string"
          },
          {
            "key": "useBrowser",
            "value": false,
            "type": "boolean"
          }
        ]
      }
    },
    {
      "name": "Admin Management (/admin/profiles)",
      "item": [
        {
          "name": "1. List All Profiles (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/profiles?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "profiles"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "role",
                  "value": "DRIVER",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Lists profiles using cursor-based pagination and optional role filter (ADMIN only)."
          }
        },
        {
          "name": "2. Create Driver Profile (Auto-generate driverId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Carlos Driver\",\n  \"email\": \"carlos.driver@eatsnow.test\",\n  \"roles\": [\"DRIVER\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/profiles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "profiles"
              ]
            },
            "description": "Creates a DRIVER profile. Automatically generates driverId claim (Spec 3.2)."
          }
        },
        {
          "name": "3. Create Restaurant Profile (With restaurantId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Burger Palace Staff\",\n  \"email\": \"staff@burgerpalace.test\",\n  \"roles\": [\"RESTAURANT\"],\n  \"restaurantId\": \"00000000-0000-4000-8000-000000000002\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/profiles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "profiles"
              ]
            },
            "description": "Creates a RESTAURANT profile. Requires restaurantId from Catalog."
          }
        },
        {
          "name": "4. Deactivate Profile (active = false)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/profiles/00000000-0000-4000-8000-000000000001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "profiles",
                "00000000-0000-4000-8000-000000000001"
              ]
            },
            "description": "Deactivates a profile. Admin cannot deactivate their own profile (409 INVALID_TRANSITION)."
          }
        }
      ],
      "auth": {
        "type": "oauth2",
        "oauth2": [
          {
            "key": "grant_type",
            "value": "authorization_code_with_pkce",
            "type": "string"
          },
          {
            "key": "authUrl",
            "value": "{{baseUrl}}/oauth2/authorize",
            "type": "string"
          },
          {
            "key": "accessTokenUrl",
            "value": "{{baseUrl}}/oauth2/token",
            "type": "string"
          },
          {
            "key": "clientId",
            "value": "eatsnow-cli",
            "type": "string"
          },
          {
            "key": "clientSecret",
            "value": "dev-cli-secret",
            "type": "string"
          },
          {
            "key": "scope",
            "value": "openid",
            "type": "string"
          },
          {
            "key": "redirect_uri",
            "value": "https://oauth.pstmn.io/v1/callback",
            "type": "string"
          },
          {
            "key": "challengeAlgorithm",
            "value": "S256",
            "type": "string"
          },
          {
            "key": "client_authentication",
            "value": "header",
            "type": "string"
          },
          {
            "key": "tokenName",
            "value": "EatsNow admin (log in as admin@eatsnow.test / password123)",
            "type": "string"
          },
          {
            "key": "addTokenTo",
            "value": "header",
            "type": "string"
          },
          {
            "key": "useBrowser",
            "value": false,
            "type": "boolean"
          }
        ]
      }
    },
    {
      "name": "Actuator & Observability (Management Port)",
      "item": [
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8083/actuator/prometheus",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "actuator",
                "prometheus"
              ]
            },
            "description": "Prometheus metric scrape endpoint on management port 8083 (8081 inside container)."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8083/actuator/health",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Service health check on management port."
          }
        }
      ],
      "auth": {
        "type": "noauth"
      }
    }
  ]
}
