      "title": "p95 latency",
      "description": "Targets: catalog reads <= 300 ms, POST /orders <= 500 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name) (k6_http_req_duration_p95{testid=~\"$testid\",group!=\"::setup\"})",
          "legendFormat": "{{name}}"
