    {
      "type": "timeseries",
      "title": "Waiting ages",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(eatsnow_pending_messages_oldest_seconds)",
          "legendFormat": "premature event"
        },
        {
          "refId": "B",
          "expr": "max(eatsnow_deliveries_unassigned_oldest_seconds)",
          "legendFormat": "unassigned delivery"
        },
        {
          "refId": "C",
          "expr": "max by (operation) (eatsnow_payment_unresolved_oldest_seconds)",
          "legendFormat": "unresolved {{operation}}"
        },
        {
          "refId": "D",
          "expr": "max by (service) (eatsnow_outbox_oldest_pending_seconds)",
          "legendFormat": "outbox {{service}}"
