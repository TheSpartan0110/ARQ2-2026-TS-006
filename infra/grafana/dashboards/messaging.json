    {
      "type": "timeseries",
      "title": "Consumer outcomes per minute",
      "description": "SUCCESS, DUPLICATE (idempotent redelivery), PENDING (premature), RETRY, FAILURE.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, outcome) (increase(eatsnow_messages_consumed_total[1m]))",
          "legendFormat": "{{service}} {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
