        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (service) (eatsnow_outbox_pending)) or vector(0)",
          "legendFormat": "",
          "instant": true
