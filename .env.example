# Copy to .env to override the local-development defaults of docker-compose.yml.
# .env is git-ignored. Never commit real credentials.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres_dev_pw
IDENTITY_DB_PASSWORD=identity_dev_pw
CATALOG_DB_PASSWORD=catalog_dev_pw
ORDERS_DB_PASSWORD=orders_dev_pw
PAYMENTS_DB_PASSWORD=payments_dev_pw
RESTAURANTS_DB_PASSWORD=restaurants_dev_pw
DELIVERIES_DB_PASSWORD=deliveries_dev_pw
NOTIFICATIONS_DB_PASSWORD=notifications_dev_pw
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_pw
# RabbitMQ users/passwords live in infra/rabbitmq/definitions.json (regenerate with generate_definitions.py).
